# Copy to .env before running docker compose.

# Signs login tokens. Generate your own: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value

# MongoDB Atlas connection string (required).
# Keep the database name (/food-delivery) before the "?". URL-encode special
# characters in the password (for example @ becomes %40).
MONGO_URI='mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/food-delivery?retryWrites=true&w=majority'

# Host port for the website
FRONTEND_PORT=8081
